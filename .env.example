# Copy to .env.local and fill in. Never commit real values.

# Supabase (local defaults are printed by `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# IMEI crypto (server-only). 32 random bytes, base64: `openssl rand -base64 32`
IMEI_ENC_KEY=
IMEI_HASH_PEPPER=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (email)
RESEND_API_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics & monitoring
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
